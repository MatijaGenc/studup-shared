{
    "name": "@studup/shared",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "prepare": "tsc && node scripts/install-hooks.cjs",
        "prepack": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "test": "node scripts/test.cjs",
        "test:gates": "node --test scripts/quality-self-test.cjs scripts/secret-scan.selftest.cjs scripts/dependency-license-inventory.test.cjs scripts/check-dependency-licenses.test.cjs",
        "secret:scan": "node scripts/secret-scan.cjs --all-tracked",
        "check": "node scripts/check.cjs",
        "format:check": "biome format .",
        "test:quality": "yarn test && yarn test:gates",
        "hooks:install": "node scripts/install-hooks.cjs",
        "test:consumers": "tsc --project tests/tsconfig.consumer.json",
        "licenses:check": "node scripts/check-dependency-licenses.cjs"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "typescript": "^7.0.0",
        "zod": "^4.0.0"
    },
    "qualityGates": {
        "manager": "yarn",
        "gates": [
            "typecheck",
            "format:check",
            "lint",
            "licenses:check",
            "build",
            "test:quality",
            "test:consumers"
        ]
    },
    "packageManager": "yarn@4.18.0"
}
